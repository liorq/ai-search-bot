# העתק ל-~/.claude/seo/.env והשלם. הקובץ הזה לא נשמר בגיט.

# GSC Wizard — נתוני Search Console ו-Bing
# מ-tool.gscwizard.com/account/api-keys
GSC_WIZARD_API_KEY=

# DataForSEO — תוצאות SERP בלבד. תור Standard, תקרה חודשית ב-budget.json
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Microsoft Clarity — Settings > Data Export > Generate API token
CLARITY_API_TOKEN=

# PageSpeed Insights — לא חובה. בלעדיו PSI עובד ונחסם מהר.
# אתר לוקאלי נמדד עם Lighthouse מקומי ולא צריך מפתח בכלל.
PAGESPEED_API_KEY=

# GA4 — נתיב לקובץ service account JSON
GA4_CREDENTIALS_PATH=

# סיסמאות אפליקציה של WordPress — אחת לכל לקוח.
# השם חייב להתאים ל-auth_env ב-clients.json
DGD_WP_APP_PASSWORD=
